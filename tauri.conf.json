          "/usr/share/icons/hicolor/64x64/apps/stream-analyzer-lite.png": "ui/icons/64x64.png",
          "/usr/share/icons/hicolor/64x64/apps/com.streamanalyzer.lite.png": "ui/icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/stream-analyzer-lite.png": "ui/icons/128x128.png",
          "/usr/share/icons/hicolor/128x128/apps/com.streamanalyzer.lite.png": "ui/icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/stream-analyzer-lite.png": "ui/icons/256x256.png",
