          "/usr/share/icons/hicolor/512x512/apps/com.streamanalyzer.lite.png": "ui/icons/512x512.png",
          "/usr/share/icons/hicolor/scalable/apps/stream-analyzer-lite.svg": "ui/icons/icon.svg",
          "/usr/share/icons/hicolor/scalable/apps/com.streamanalyzer.lite.svg": "ui/icons/icon.svg",
          "/usr/share/pixmaps/stream-analyzer-lite.png": "ui/icons/icon.png",
          "/usr/share/pixmaps/com.streamanalyzer.lite.png": "ui/icons/icon.png"
        }
      }
    }
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Stream Analyzer Lite",
        "width": 1024,
        "height": 700
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["main"],
          "permissions": ["dialog:default"]
        }
      ]
    }
  }
}
