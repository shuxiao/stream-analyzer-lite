{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stream-analyzer-lite",
  "version": "0.1.0",
  "identifier": "com.streamanalyzer.lite",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "active": true,
    "icon": [
      "ui/icons/32x32.png",
      "ui/icons/128x128.png",
      "ui/icons/128x128@2x.png",
      "ui/icons/icon.png"
    ],
    "resources": [
      "analyzer-core/stream-analyzer-core"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/linux/stream-analyzer-lite.desktop.hbs",
        "postInstallScript": "packaging/linux/postinst.sh",
        "postRemoveScript": "packaging/linux/postrm.sh",
        "files": {
          "/usr/share/icons/hicolor/16x16/apps/stream-analyzer-lite.png": "ui/icons/16x16.png",
          "/usr/share/icons/hicolor/16x16/apps/com.streamanalyzer.lite.png": "ui/icons/16x16.png",
          "/usr/share/applications/com.streamanalyzer.lite.desktop": "packaging/linux/com.streamanalyzer.lite.desktop",
